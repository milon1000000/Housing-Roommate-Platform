model Property {
  id            String   @id @default(uuid())
  title         String
  description   String
  address       String
  city          String
  rentPrice     Float
  totalRooms    Int
  amenities     String[] // e.g. ["WiFi", "AC", "Parking"]
  imageUrl      String[]
  imagePublicId String[]

  isAvailable Boolean @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  landlordId String
  landlord   Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  rooms        Room[]
  bookings     Booking[]

  @@index([city], name: "idx_property_city")
  @@map("properties")
}
