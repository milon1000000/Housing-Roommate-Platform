<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Housing & Roommate Platform</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #333333;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f4f7fb; padding: 40px 15px"
    >
      <tr>
        <td align="center">
          <!-- Main Container -->
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 600px;
              width: 100%;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="background-color: #2563eb; padding: 30px 20px"
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 26px;
                    font-weight: 700;
                  "
                >
                  Housing & Roommate
                </h1>

                <p style="margin: 8px 0 0; color: #dbeafe; font-size: 14px">
                  Find Your Perfect Home & Compatible Roommates
                </p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 40px 35px">
                <h2 style="margin: 0 0 18px; color: #1f2937; font-size: 22px">
                  Welcome, <%= name %>! 👋
                </h2>

                <p
                  style="
                    margin: 0 0 18px;
                    font-size: 16px;
                    line-height: 1.7;
                    color: #4b5563;
                  "
                >
                  We are excited to have you on board at
                  <strong>Housing & Roommate Platform</strong>. Your account has been
                  successfully verified and created.
                </p>

                <p
                  style="
                    margin: 0 0 25px;
                    font-size: 16px;
                    line-height: 1.7;
                    color: #4b5563;
                  "
                >
                  Whether you are looking for a comfortable place to stay or searching for 
                  trustworthy roommates to share rent with, our platform makes the process seamless and secure.
                </p>

                <!-- Features -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #eff6ff;
                    border-radius: 10px;
                    margin-bottom: 30px;
                  "
                >
                  <tr>
                    <td style="padding: 20px">
                      <h3
                        style="
                          margin: 0 0 15px;
                          color: #1d4ed8;
                          font-size: 18px;
                        "
                      >
                        What you can do next:
                      </h3>

                      <p style="margin: 8px 0; color: #374151; font-size: 14px">
                        ✓ Browse verified rental listings and rooms
                      </p>

                      <p style="margin: 8px 0; color: #374151; font-size: 14px">
                        ✓ Connect and chat with potential roommates
                      </p>

                      <p style="margin: 8px 0; color: #374151; font-size: 14px">
                        ✓ Post your own room or housing availability
                      </p>

                      <p style="margin: 8px 0; color: #374151; font-size: 14px">
                        ✓ Manage bookings and rental requests securely
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 30px 0 0;
                    font-size: 14px;
                    line-height: 1.6;
                    color: #6b7280;
                    text-align: center;
                  "
                >
                  Thank you for choosing Housing & Roommate Platform. We wish you a great experience!
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  background-color: #f8fafc;
                  padding: 25px 20px;
                  border-top: 1px solid #e5e7eb;
                "
              >
                <p style="margin: 0 0 8px; font-size: 13px; color: #6b7280">
                  © <%= new Date().getFullYear() %> Housing & Roommate Platform. All rights reserved.
                </p>

                <p style="margin: 0; font-size: 12px; color: #9ca3af">
                  This is an automated email. Please do not reply to this message.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>