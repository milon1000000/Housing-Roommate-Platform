<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Your Email</title>
</head>

<body style="
  margin:0;
  padding:0;
  background-color:#f5f7fb;
  font-family:Arial, Helvetica, sans-serif;
">

  <table
    role="presentation"
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="background-color:#f5f7fb; padding:40px 15px;"
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          role="presentation"
          width="100%"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width:520px;
            background-color:#ffffff;
            border-radius:12px;
            overflow:hidden;
            border:1px solid #e8ebf0;
          "
        >

          <!-- Header -->
          <tr>
            <td
              align="center"
              style="
                background-color:#2563eb;
                padding:30px 25px;
              "
            >
              <div
                style="
                  color:#ffffff;
                  font-size:24px;
                  font-weight:700;
                  letter-spacing:0.3px;
                "
              >
                Housing & Roommate
              </div>

              <div
                style="
                  margin-top:8px;
                  color:#dbeafe;
                  font-size:14px;
                "
              >
                Find Your Perfect Home & Roommate
              </div>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:35px 35px 30px;">

              <!-- Greeting -->
              <p
                style="
                  margin:0 0 18px;
                  color:#111827;
                  font-size:16px;
                  line-height:1.6;
                "
              >
                Hello <strong><%= name %></strong>,
              </p>

              <p
                style="
                  margin:0 0 18px;
                  color:#4b5563;
                  font-size:15px;
                  line-height:1.7;
                "
              >
                Thank you for creating a tenant account with
                <strong>Housing & Roommate Platform</strong>.
                Please verify your email address using the verification code below.
              </p>

              <!-- OTP Section -->
              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="margin:25px 0;"
              >
                <tr>
                  <td
                    align="center"
                    style="
                      background-color:#eff6ff;
                      border:1px solid #bfdbfe;
                      border-radius:10px;
                      padding:25px 15px;
                    "
                  >

                    <div
                      style="
                        color:#64748b;
                        font-size:13px;
                        font-weight:600;
                        text-transform:uppercase;
                        letter-spacing:1px;
                        margin-bottom:12px;
                      "
                    >
                      Verification Code
                    </div>

                    <div
                      style="
                        color:#1d4ed8;
                        font-size:34px;
                        font-weight:700;
                        letter-spacing:8px;
                        line-height:1.2;
                      "
                    >
                      <%= otpValue %>
                    </div>

                  </td>
                </tr>
              </table>

              <!-- Expiration -->
              <p
                style="
                  margin:0 0 20px;
                  text-align:center;
                  color:#6b7280;
                  font-size:13px;
                  line-height:1.6;
                "
              >
                This verification code will expire in
                <strong><%= expireMinites %> minutes</strong>.
              </p>

              <!-- Security Notice -->
              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background-color:#f9fafb;
                  border-radius:8px;
                  margin-top:20px;
                "
              >
                <tr>
                  <td style="padding:15px 18px;">

                    <p
                      style="
                        margin:0;
                        color:#6b7280;
                        font-size:13px;
                        line-height:1.6;
                      "
                    >
                      <strong style="color:#374151;">
                        Security notice:
                      </strong>
                      Never share this verification code with anyone.
                      Housing & Roommate Platform will never ask you for your OTP or password.
                    </p>

                  </td>
                </tr>
              </table>

              <p
                style="
                  margin:25px 0 0;
                  color:#6b7280;
                  font-size:13px;
                  line-height:1.6;
                "
              >
                If you did not create an account with Housing & Roommate Platform,
                you can safely ignore this email.
              </p>

              <p
                style="
                  margin:25px 0 0;
                  color:#374151;
                  font-size:14px;
                  line-height:1.6;
                "
              >
                Regards,<br>
                <strong>Housing & Roommate Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              align="center"
              style="
                background-color:#f9fafb;
                border-top:1px solid #e5e7eb;
                padding:20px 25px;
              "
            >

              <p
                style="
                  margin:0 0 8px;
                  color:#9ca3af;
                  font-size:12px;
                "
              >
                © <%= new Date().getFullYear() %> Housing & Roommate Platform.
                All rights reserved.
              </p>

              <p
                style="
                  margin:0;
                  color:#9ca3af;
                  font-size:11px;
                  line-height:1.5;
                "
              >
                This is an automated email. Please do not reply to this message.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>