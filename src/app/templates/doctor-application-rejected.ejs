<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Doctor Application Rejected</title>
</head>

<body style="margin:0; padding:0; background-color:#f5f7fb; font-family:Arial, Helvetica, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0"
    style="background-color:#f5f7fb; padding:40px 15px;">

    <tr>
      <td align="center">

        <table width="600" cellpadding="0" cellspacing="0" border="0"
          style="width:100%; max-width:600px; background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 4px 15px rgba(0,0,0,0.06);">

          <!-- Header -->
          <tr>
            <td align="center"
              style="background:linear-gradient(135deg,#ef4444,#dc2626); padding:35px 20px;">

              <div style="
                width:65px;
                height:65px;
                line-height:65px;
                margin:0 auto 15px;
                border-radius:50%;
                background:#ffffff;
                color:#dc2626;
                font-size:34px;
                font-weight:bold;
              ">
                !
              </div>

              <h1 style="
                margin:0;
                color:#ffffff;
                font-size:28px;
                font-weight:700;
              ">
                Application Update
              </h1>

              <p style="
                margin:10px 0 0;
                color:#fee2e2;
                font-size:15px;
              ">
                Doctor application review result
              </p>

            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:40px 35px;">

              <h2 style="
                margin:0 0 15px;
                color:#111827;
                font-size:22px;
              ">
                Hello, <%= name %>
              </h2>

              <p style="
                margin:0 0 18px;
                color:#4b5563;
                font-size:16px;
                line-height:1.7;
              ">
                Thank you for your interest in joining our healthcare platform
                as a doctor.
              </p>

              <p style="
                margin:0 0 20px;
                color:#4b5563;
                font-size:16px;
                line-height:1.7;
              ">
                After carefully reviewing your submitted information and
                documents, we regret to inform you that your application
                has not been approved at this time.
              </p>

              <!-- Status Card -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="margin:25px 0; background:#fef2f2; border:1px solid #fecaca; border-radius:10px;">

                <tr>
                  <td style="padding:20px;">

                    <p style="
                      margin:0 0 8px;
                      color:#6b7280;
                      font-size:13px;
                      text-transform:uppercase;
                    ">
                      Application Status
                    </p>

                    <p style="
                      margin:0;
                      color:#dc2626;
                      font-size:20px;
                      font-weight:bold;
                    ">
                      ✕ REJECTED
                    </p>

                  </td>
                </tr>

              </table>

              <!-- Rejection Reason -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="margin:25px 0; background:#fff7ed; border-left:4px solid #f97316;">

                <tr>
                  <td style="padding:20px;">

                    <h3 style="
                      margin:0 0 10px;
                      color:#9a3412;
                      font-size:17px;
                    ">
                      Reason for Rejection
                    </h3>

                    <p style="
                      margin:0;
                      color:#7c2d12;
                      font-size:15px;
                      line-height:1.7;
                    ">
                      <%= reason || "No specific reason was provided." %>
                    </p>

                  </td>
                </tr>

              </table>

              <p style="
                margin:0 0 18px;
                color:#4b5563;
                font-size:16px;
                line-height:1.7;
              ">
                We encourage you to review the reason mentioned above and
                make the necessary corrections before submitting another
                application.
              </p>

              <!-- Support -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="margin:25px 0; background:#f9fafb; border-radius:10px;">

                <tr>
                  <td style="padding:18px;">

                    <p style="
                      margin:0;
                      color:#374151;
                      font-size:14px;
                      line-height:1.6;
                    ">
                      <strong>Need help?</strong><br />
                      If you believe this decision was made in error or need
                      additional clarification, please contact our support team.
                    </p>

                  </td>
                </tr>

              </table>

              <p style="
                margin:25px 0 0;
                color:#374151;
                font-size:15px;
                line-height:1.6;
              ">
                Best regards,<br />
                <strong>Healthcare Platform Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center"
              style="padding:22px; background:#f9fafb; border-top:1px solid #e5e7eb;">

              <p style="
                margin:0 0 8px;
                color:#9ca3af;
                font-size:13px;
              ">
                © <%= new Date().getFullYear() %> Healthcare Platform
              </p>

              <p style="
                margin:0;
                color:#9ca3af;
                font-size:12px;
              ">
                This is an automated email. Please do not reply to this email.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>

  </table>

</body>
</html>