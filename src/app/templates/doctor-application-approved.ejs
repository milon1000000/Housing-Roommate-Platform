<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Doctor Application Approved</title>
</head>

<body style="margin:0; padding:0; background-color:#f5f7fb; font-family:Arial, Helvetica, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0"
    style="background-color:#f5f7fb; padding:40px 15px;">

    <tr>
      <td align="center">

        <table width="600" cellpadding="0" cellspacing="0" border="0"
          style="width:100%; max-width:600px; background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 4px 15px rgba(0,0,0,0.06);">

          <!-- Header -->
          <tr>
            <td align="center"
              style="background:linear-gradient(135deg,#16a34a,#15803d); padding:35px 20px;">

              <div style="
                width:65px;
                height:65px;
                line-height:65px;
                margin:0 auto 15px;
                border-radius:50%;
                background:#ffffff;
                color:#16a34a;
                font-size:36px;
                font-weight:bold;
              ">
                ✓
              </div>

              <h1 style="
                margin:0;
                color:#ffffff;
                font-size:28px;
                font-weight:700;
              ">
                Application Approved
              </h1>

              <p style="
                margin:10px 0 0;
                color:#dcfce7;
                font-size:15px;
              ">
                Welcome to our healthcare platform
              </p>

            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:40px 35px;">

              <h2 style="
                margin:0 0 15px;
                color:#111827;
                font-size:22px;
              ">
                Congratulations, <%= name %>!
              </h2>

              <p style="
                margin:0 0 18px;
                color:#4b5563;
                font-size:16px;
                line-height:1.7;
              ">
                We are pleased to inform you that your application to become
                a doctor on our platform has been successfully reviewed and
                <strong style="color:#16a34a;">approved</strong>.
              </p>

              <!-- Status Card -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="margin:25px 0; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px;">

                <tr>
                  <td style="padding:20px;">

                    <p style="
                      margin:0 0 8px;
                      color:#6b7280;
                      font-size:13px;
                      text-transform:uppercase;
                    ">
                      Application Status
                    </p>

                    <p style="
                      margin:0;
                      color:#15803d;
                      font-size:20px;
                      font-weight:bold;
                    ">
                      ✓ APPROVED
                    </p>

                  </td>
                </tr>

              </table>

              <p style="
                margin:0 0 18px;
                color:#4b5563;
                font-size:16px;
                line-height:1.7;
              ">
                Your doctor account is now active. You can log in to your
                account and start managing your profile, appointments,
                consultations and other doctor services.
              </p>

              <!-- Login Button -->
              <table cellpadding="0" cellspacing="0" border="0"
                style="margin:30px auto;">

                <tr>
                  <td align="center"
                    style="background:#16a34a; border-radius:8px;">

                    <a href="<%= loginUrl %>"
                      style="
                        display:inline-block;
                        padding:14px 30px;
                        color:#ffffff;
                        text-decoration:none;
                        font-size:16px;
                        font-weight:bold;
                      ">
                      Login to Your Account
                    </a>

                  </td>
                </tr>

              </table>

              <!-- Security Notice -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="background:#f9fafb; border-radius:10px;">

                <tr>
                  <td style="padding:18px;">

                    <p style="
                      margin:0;
                      color:#374151;
                      font-size:14px;
                      line-height:1.6;
                    ">
                      <strong>Security Notice:</strong>
                      Please change your temporary password immediately
                      after your first login.
                    </p>

                  </td>
                </tr>

              </table>

              <p style="
                margin:25px 0 0;
                color:#6b7280;
                font-size:14px;
                line-height:1.6;
              ">
                If you have any questions, please contact our support team.
              </p>

              <p style="
                margin:25px 0 0;
                color:#374151;
                font-size:15px;
                line-height:1.6;
              ">
                Best regards,<br />
                <strong>Healthcare Platform Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center"
              style="padding:22px; background:#f9fafb; border-top:1px solid #e5e7eb;">

              <p style="
                margin:0 0 8px;
                color:#9ca3af;
                font-size:13px;
              ">
                © <%= new Date().getFullYear() %> Healthcare Platform
              </p>

              <p style="
                margin:0;
                color:#9ca3af;
                font-size:12px;
              ">
                This is an automated email. Please do not reply to this email.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>

  </table>

</body>
</html>