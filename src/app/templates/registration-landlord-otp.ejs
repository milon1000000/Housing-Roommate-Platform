<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Landlord Email Verification</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f5f7fb;
  font-family: Arial, Helvetica, sans-serif;
">

  <table
    role="presentation"
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="
      width: 100%;
      background-color: #f5f7fb;
      padding: 40px 15px;
    "
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          role="presentation"
          width="100%"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width: 520px;
            width: 100%;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #e8ebf0;
          "
        >

          <!-- Header -->
          <tr>
            <td
              align="center"
              style="
                background-color: #4f46e5;
                padding: 30px 25px;
              "
            >

              <div
                style="
                  color: #ffffff;
                  font-size: 24px;
                  font-weight: 700;
                  letter-spacing: 0.3px;
                "
              >
                Housing Platform
              </div>

              <div
                style="
                  margin-top: 8px;
                  color: #e0e7ff;
                  font-size: 14px;
                "
              >
                Landlord Email Verification
              </div>

            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td
              style="
                padding: 35px 35px 30px;
              "
            >

              <!-- Greeting -->
              <p
                style="
                  margin: 0 0 18px;
                  color: #111827;
                  font-size: 16px;
                  line-height: 1.6;
                "
              >
                Hello
                <strong><%= name %></strong>,
              </p>

              <!-- Message -->
              <p
                style="
                  margin: 0 0 18px;
                  color: #4b5563;
                  font-size: 15px;
                  line-height: 1.7;
                "
              >
                Thank you for applying as a Landlord on
                <strong>Housing Platform</strong>.
                Your application has been received successfully.
                Please verify your email address using the verification
                code below.
              </p>

              <!-- OTP Box -->
              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  margin: 28px 0;
                "
              >
                <tr>
                  <td
                    align="center"
                    style="
                      background-color: #eff6ff;
                      border: 1px solid #bfdbfe;
                      border-radius: 10px;
                      padding: 30px 15px;
                    "
                  >

                    <!-- OTP Label -->
                    <div
                      style="
                        color: #64748b;
                        font-size: 13px;
                        font-weight: 600;
                        text-transform: uppercase;
                        letter-spacing: 1px;
                        margin-bottom: 15px;
                      "
                    >
                      Email Verification Code
                    </div>

                    <!-- OTP -->
                    <div
                      style="
                        color: #4f46e5;
                        font-size: 42px;
                        font-weight: 700;
                        letter-spacing: 10px;
                        line-height: 1.2;
                        font-family: Arial, Helvetica, sans-serif;
                      "
                    >
                      <%= otpValue %>
                    </div>

                  </td>
                </tr>
              </table>

              <!-- Expiration -->
              <p
                style="
                  margin: 0 0 20px;
                  text-align: center;
                  color: #6b7280;
                  font-size: 13px;
                  line-height: 1.6;
                "
              >
                This verification code will expire in
                <strong>
                  <%= expireMinutes %> minutes
                </strong>.
              </p>

              <!-- Security Notice -->
              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background-color: #f9fafb;
                  border-radius: 8px;
                  margin-top: 20px;
                "
              >
                <tr>
                  <td
                    style="
                      padding: 15px 18px;
                    "
                  >

                    <p
                      style="
                        margin: 0;
                        color: #6b7280;
                        font-size: 13px;
                        line-height: 1.6;
                      "
                    >

                      <strong
                        style="
                          color: #374151;
                        "
                      >
                        Security Notice:
                      </strong>

                      Never share this verification code with anyone.
                      Housing Platform will never ask you for your OTP
                      or password.

                    </p>

                  </td>
                </tr>
              </table>

              <!-- Ignore Message -->
              <p
                style="
                  margin: 25px 0 0;
                  color: #6b7280;
                  font-size: 13px;
                  line-height: 1.6;
                "
              >
                If you did not submit a landlord application with
                <strong>Housing Platform</strong>,
                you can safely ignore this email.
              </p>

              <!-- Regards -->
              <p
                style="
                  margin: 25px 0 0;
                  color: #374151;
                  font-size: 14px;
                  line-height: 1.6;
                "
              >
                Regards,<br>
                <strong>Housing Platform Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              align="center"
              style="
                background-color: #f9fafb;
                border-top: 1px solid #e5e7eb;
                padding: 20px 25px;
              "
            >

              <p
                style="
                  margin: 0 0 8px;
                  color: #9ca3af;
                  font-size: 12px;
                "
              >
                © <%= new Date().getFullYear() %>
                Housing Platform.
                All rights reserved.
              </p>

              <p
                style="
                  margin: 0;
                  color: #9ca3af;
                  font-size: 11px;
                  line-height: 1.5;
                "
              >
                This is an automated email.
                Please do not reply to this message.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>